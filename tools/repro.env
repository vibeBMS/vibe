# The pinned build environment of the release builds (docs/BUILDING.md,
# "Reproducible builds"). CI's jobs, tools/build_release.sh and
# tools/reproduce.sh read it (it is sourced by bash: plain assignments only,
# one per line: the Toolchain pins workflow rewrites them). Rust itself is
# rust-toolchain.toml's; wasm-bindgen-cli is Cargo.lock's wasm-bindgen.

# vibebms-linux-x64, -arm64 (the in-app browser): the Ubuntu 22.04 images, by
# digest of each architecture's image (glibc 2.35 and WebKitGTK 4.1, the
# release's baseline), and the packages tools/build_deps.sh installs in them:
# x64's from the Ubuntu snapshot at UBUNTU_SNAPSHOT; arm64's, which come from
# the ports archive (the snapshot service has no copy of it), as
# tools/linux-arm64.lock lists them (each one's version and SHA-256)
LINUX_IMAGE_X64=docker.io/library/ubuntu:22.04@sha256:45e9ddc6895604674618a409ca9f73d301da8fdb75fe330e8e9a27b3b219e4ad
LINUX_IMAGE_ARM64=docker.io/library/ubuntu:22.04@sha256:0904b10431fdf0800b659e0039e484e3af097f7d81539dc55dd65d23729d7735
LINUX_PACKAGES="ca-certificates curl gcc libc6-dev pkg-config libasound2-dev libudev-dev libwebkit2gtk-4.1-dev"

# vibebms-linux-*-portable: the manylinux_2_28 (AlmaLinux 8) images, by digest,
# and the packages tools/build_deps.sh installs in them
PORTABLE_IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64@sha256:d086f64cddcace250ef0f0073583c51b8298159303290a730c9f59bd91edfd2c
PORTABLE_IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64@sha256:34a5e614a4eb26f73f8bf44cbbf2acf8011620453d03ea35a58537bb3cde44de
PORTABLE_PACKAGES="alsa-lib-devel systemd-devel pkgconf-pkg-config"

# the web build: an Ubuntu image by digest, its packages from the Ubuntu
# snapshot service as they were at UBUNTU_SNAPSHOT (clang compiles Lua into the
# module); WEB_CC / WEB_AR are the compiler and archiver for wasm32
WEB_IMAGE=docker.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
UBUNTU_SNAPSHOT=20261119T000000Z
WEB_PACKAGES="ca-certificates curl git gcc libc6-dev clang-21 llvm-21 nodejs zip unzip"
WEB_CC=clang-21
WEB_AR=llvm-ar-21

# the macOS .dmg (tools/package_dmg.sh), made on Linux from the app's zip: in
# LINUX_IMAGE_X64, these packages from the Ubuntu snapshot (hfsprogs'
# mkfs.hfsplus, and what builds libdmg-hfsplus), and libdmg-hfsplus (its
# hfsplus and dmg) built from Mozilla's repository at this commit
DMG_PACKAGES="ca-certificates git cmake make gcc g++ libc6-dev zlib1g-dev libbz2-dev hfsprogs unzip python3"
LIBDMG_HFSPLUS_COMMIT=e18579b391950589b9ed16ee630c54ce4319bb29

# macOS and iOS: the runner image (its label) and the Xcode in it, a
# major.minor release: /Applications/Xcode_<it>.app or the newest
# Xcode_<it>.<patch>.app, selected through DEVELOPER_DIR (its clang, linker,
# SDKs, lipo and codesign). An image replaces a patch release by the next, and
# while a new image rolls out a label's runners have either: build.txt names
# the one used.
MACOS_RUNNER=macos-26
XCODE_VERSION=26.6

# Windows: the runner image (its label), the MSVC toolset (cl, link and the C
# runtime) and the Windows SDK (Windows Kits\10\Lib\<version>), selected
# through vcvarsall.bat. The toolset is a side-by-side one, the installer's
# component Microsoft.VisualStudio.Component.VC.<MSVC_COMPONENT>.<x86.x64|ARM64>
# (VC\Tools\MSVC\<major.minor>.<build>), which no image update replaces:
# Visual Studio's own toolset is replaced by each of its updates (14.51 by
# 14.52 with 18.12), and while the new image rolls out a label's runners have
# either. CI adds the component's ARM64 tools, which the image lacks.
WINDOWS_RUNNER=windows-2025-vs2026
MSVC_COMPONENT=14.44.17.14
WINDOWS_SDK=10.0.26100.0

# Android (.github/actions/android-setup): the NDK (sdkmanager's version),
# cargo-ndk, the JDK and Gradle (the Android Gradle plugin:
# platform/android/build.gradle.kts), and the build-tools whose apksigner signs
# the APK Gradle builds unsigned (tools/build_release.sh android)
NDK_VERSION=30.0.16248370
CARGO_NDK_VERSION=4.1.2
JAVA_VERSION=17.0.21
GRADLE_VERSION=9.9.2
BUILD_TOOLS_VERSION=37.0.0
