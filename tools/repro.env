# The pinned build environment of the release builds (docs/BUILDING.md,
# "Reproducible builds"). CI's jobs and tools/reproduce.sh read it (it is
# sourced by bash: plain assignments only). Rust itself is rust-toolchain.toml's;
# wasm-bindgen-cli is Cargo.lock's wasm-bindgen.

# vibebms-linux-*-portable: the manylinux_2_28 (AlmaLinux 8) images, by digest,
# and the packages tools/build_deps.sh installs in them
PORTABLE_IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64@sha256:d086f64cddcace250ef0f0073583c51b8298159303290a730c9f59bd91edfd2c
PORTABLE_IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64@sha256:34a5e614a4eb26f73f8bf44cbbf2acf8011620453d03ea35a58537bb3cde44de
PORTABLE_PACKAGES="alsa-lib-devel systemd-devel pkgconf-pkg-config"

# the web build: an Ubuntu image by digest, its packages from the Ubuntu
# snapshot service as they were at UBUNTU_SNAPSHOT (clang compiles Lua into the
# module); WEB_CC / WEB_AR are the compiler and archiver for wasm32
WEB_IMAGE=docker.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
UBUNTU_SNAPSHOT=20261119T000000Z
WEB_PACKAGES="ca-certificates curl git gcc libc6-dev clang-21 llvm-21 nodejs zip unzip"
WEB_CC=clang-21
WEB_AR=llvm-ar-21

# Android (.github/actions/android-setup): the NDK (sdkmanager's version),
# cargo-ndk, the JDK and Gradle (the Android Gradle plugin:
# platform/android/build.gradle.kts)
NDK_VERSION=30.0.16248370
CARGO_NDK_VERSION=4.1.2
JAVA_VERSION=17.0.21
GRADLE_VERSION=9.6.0
