# What the beatoraja comparison runs (tools/e2e/beatoraja; docs/BUILDING.md,
# "Comparison with beatoraja"): beatoraja's release as its author publishes
# it (the GitHub release of exch-bms2/beatoraja carries no binaries; its
# README links this download), and a Java runtime with JavaFX, which
# beatoraja's launcher needs. Each is checked against its SHA-256.
BEATORAJA_VERSION=0.8.9
BEATORAJA_URL=https://mocha-repository.info/download/beatoraja/0.8.9/modernchic
BEATORAJA_SHA256=14f2da525f12160d9e087d0a92d02bb4106adc92f964b11c9a76b403ed5ecc84
JRE_VERSION=21.0.12.1+1
JRE_URL=https://github.com/bell-sw/Liberica/releases/download/21.0.12.1+1/bellsoft-jre21.0.12.1+1-linux-amd64-full.tar.gz
JRE_SHA256=eadc5aa15f66fc137102d7fcaabc26299ee87568aeaf14a95b211ed94e5f416a
